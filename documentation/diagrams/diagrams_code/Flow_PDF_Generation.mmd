flowchart TD
    A([GET /student/album/zal_key/pobierz]) --> B{Dostep do studenta?}
    B -- Nie --> B1[403 lub przekierowanie z komunikatem]
    B -- Tak --> C[Pobierz formularz i numer rewizji]
    C --> D{Aktualna rewizja zatwierdzona?}
    D -- Nie --> D1[Przekierowanie z komunikatem]
    D -- Tak --> E[Checksum danych + wersja szablonu]
    E --> F{Istnieje identyczny PDF?}
    F -- Tak --> G[Zwroc wersje archiwalna]
    F -- Nie --> H[Render Jinja2 do LaTeX]
    H --> I[XeLaTeX x2, no-shell-escape, timeout 60 s]
    I --> J{Kompilacja poprawna?}
    J -- Nie --> J1[Log + kontrolowany komunikat bledu]
    J -- Tak --> K[Walidacja sygnatury PDF]
    K --> L[Zapis wersji, SHA-256 i fingerprint]
    L --> M[Audyt operacji]
    M --> G
    G --> N([application/pdf + bezpieczna nazwa pliku])

    classDef err fill:#fff1f2,stroke:#e11d48,color:#7f1d1d,stroke-width:1px;
    class B1,D1,J1 err;

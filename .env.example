# ─── WYMAGANE – uzupełnij przed uruchomieniem ────────────────────────────────

# Klucz sesji Flask (min. 32 losowe znaki)
SECRET_KEY=

# Hasło roota MariaDB
MYSQL_ROOT_PASSWORD=

# Hasło użytkownika aplikacji MariaDB
MYSQL_PASSWORD=

# ─── Baza danych ──────────────────────────────────────────────────────────────

# Nazwa bazy
MYSQL_DATABASE=ems

# Użytkownik aplikacji
MYSQL_USER=ems_user

# Połączenie do MariaDB:
#   Docker Compose (host "db" = nazwa serwisu):
DATABASE_URL=mysql+pymysql://ems_user:MYSQL_PASSWORD_TUTAJ@db:3306/ems?charset=utf8mb4
#   Lokalnie (MariaDB uruchomiona osobno):
# DATABASE_URL=mysql+pymysql://ems_user:MYSQL_PASSWORD_TUTAJ@localhost:3306/ems?charset=utf8mb4

# ─── MongoDB (treść formularzy Zał. 1–8) ─────────────────────────────────────
#   Docker Compose (host "mongo" = nazwa serwisu); nazwa bazy na końcu URL:
MONGO_URL=mongodb://mongo:27017/ems
#   Lokalnie (MongoDB uruchomiona osobno):
# MONGO_URL=mongodb://localhost:27017/ems

# ─── Porty ───────────────────────────────────────────────────────────────────

# Port hosta wystawiany przez Docker dla MariaDB (domyślnie 3306)
DB_PORT=3306
# Port hosta wystawiany przez Docker dla MongoDB (domyślnie 27017)
MONGO_PORT=27017

# ─── Flask ────────────────────────────────────────────────────────────────────

# Adres nasłuchu Flask
#   0.0.0.0  – w Dockerze (wymagane aby kontener był dostępny z zewnątrz)
#   127.0.0.1 – lokalnie bez Dockera
FLASK_HOST=127.0.0.1

# Port aplikacji (musi być spójny z DATABASE_URL i mapowaniem portów w docker-compose)
FLASK_PORT=5000

# Tryb debugowania (true tylko lokalnie, nigdy w produkcji)
FLASK_DEBUG=false
DEBUG_LOGIN_BUTTONS=false

# Ustaw true, gdy aplikacja działa wyłącznie przez HTTPS
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
ENABLE_HSTS=false
JSON_LOGS=false

# Hasła kont tworzonych przez `python -m core.seed` (minimum 12 znaków)
SEED_STUDENT_PASSWORD=
SEED_STUDENT4_PASSWORD=
SEED_UOPZ_PASSWORD=
SEED_ZOPZ_PASSWORD=
SEED_DZIEKANAT_PASSWORD=
SEED_ADMIN_PASSWORD=

# ─── Microsoft OAuth (opcjonalne) ─────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=
# Lista domen oddzielonych przecinkami, np. ans-elblag.pl,student.ans-elblag.pl
MS_ALLOWED_EMAIL_DOMAINS=
MS_STAFF_EMAIL_DOMAIN=ans-elblag.pl

# Zaproszenia dla zakładowych opiekunów praktyk
ZOPZ_INVITATION_HOURS=168
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=praktyki@ans-elblag.pl
PUBLIC_BASE_URL=
